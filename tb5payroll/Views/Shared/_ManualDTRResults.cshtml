@model List<tb5payroll.Controllers.DashboardController.SheetDTRData>

<div class="mt-4" id="dtrResultsContainer">
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No DTR data found in the selected sheets.
        </div>
    }
    else
    {
        <ul class="nav nav-tabs" id="sheetTabs" role="tablist">
            @for (int i = 0; i < Model.Count; i++)
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(i == 0 ? "active" : "")"
                            id="tab-@i"
                            data-bs-toggle="tab"
                            data-bs-target="#sheet-@i"
                            type="button"
                            role="tab">
                        @Model[i].SheetName
                    </button>
                </li>
            }
        </ul>

        <div class="tab-content p-3 border border-top-0 rounded-bottom" id="sheetTabContent">
            @for (int i = 0; i < Model.Count; i++)
            {
                var sheet = Model[i];
                <div class="tab-pane fade @(i == 0 ? "show active" : "")"
                     id="sheet-@i"
                     role="tabpanel">

                    @foreach (var employee in sheet.Employees)
                    {
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Employee ID: @employee.EmployeeId</h5>
                                <small class="text-muted">Period: @employee.DatePeriod</small>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive" style="max-height: 300px;">
                                    <table class="table table-sm table-bordered mb-0">
                                        <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Time In</th>
                                            <th>Time Out</th>
                                            <th>Total Hours</th>
                                            <th>Overtime (mins)</th>
                                            <th>Undertime (mins)</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var record in employee.Records)
                                        {
                                            <tr>
                                                <td>@record.Date</td>
                                                <td>@record.TimeIn</td>
                                                <td>@record.TimeOut</td>
                                                <td class="@(record.TotalHours < 8 ? "text-danger" : "text-success")">
                                                    @record.TotalHours.ToString("0.00")
                                                </td>
                                                <td>@record.OvertimeMinutes</td>
                                                <td>@record.UndertimeMinutes</td>
                                            </tr>
                                        }
                                        <tr class="table-secondary fw-bold">
                                            <td colspan="3">Period Totals</td>
                                            <td>@employee.Records.Sum(r => r.TotalHours).ToString("0.00")</td>
                                            <td>@employee.Records.Sum(r => r.OvertimeMinutes)</td>
                                            <td>@employee.Records.Sum(r => r.UndertimeMinutes)</td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<style>
    .table-responsive {
        overflow-y: auto;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }

    .nav-tabs .nav-link {
        padding: 0.5rem 1rem;
    }

    .text-danger {
        color: #dc3545 !important;
    }

    .text-success {
        color: #28a745 !important;
    }
</style>